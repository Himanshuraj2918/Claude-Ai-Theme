{
  "name": "claude-ai-theme",
  "displayName": "Claude AI",
  "description": "A VS Code theme matching claude.ai's warm terracotta color system, in dark and light variants.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "label": "Claude AI Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-dark-color-theme.json"
      },
      {
        "label": "Claude AI Light",
        "uiTheme": "vs",
        "path": "./themes/claude-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
      "editor.fontLigatures": true,
      "editor.fontSize": 14
    }
  }
}
