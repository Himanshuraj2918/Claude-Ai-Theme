{
  "name": "claude-ai-theme",
  "displayName": "Claude Code Theme",
  "description": "A VS Code theme matching claude.ai's warm terracotta color system, in dark and light variants.",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "He-Man",
  "icon": "Images/icon.png",
  "homepage": "https://github.com/Himanshuraj2918/Claude-Ai-Theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Himanshuraj2918/Claude-Ai-Theme.git"
  },
  "bugs": {
    "url": "https://github.com/Himanshuraj2918/Claude-Ai-Theme/issues"
  },
  "keywords": [
    "theme",
    "dark",
    "light",
    "terracotta",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "label": "Claude AI Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-dark-color-theme.json"
      },
      {
        "label": "Claude AI Light",
        "uiTheme": "vs",
        "path": "./themes/claude-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
      "editor.fontLigatures": true,
      "editor.fontSize": 14
    }
  }
}
